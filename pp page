        .photo{
            width: 150px;
            height:150px;
            background-color:#a32626;
            border-radius:50%;
            display :flex;
            justify-content:center;
            align-items:center;
            margin:0 ;
            line-height:150px;
            font-weight:50;
        }

        h1{
            color:#626066;
        }

        p{
            color: #050000 lack;;
            max-width:400px;
            margin:0;
        }

        button{
            margin-top:20px;
            padding:10px 20px;
            font-size:16px;
            background-color:#007bff;
            color:black;
            border:none;
            border-radius:5px;
            cursor:pointer;
        }

        button:hover{
            background-color:#0056b3;
        }

        footer{
            background-color:blue;
            color:white;
            text-align:left;
            padding:15px;
            margin-top:40px;
        }
