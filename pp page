<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Profile Page</title>

    <style>
        body{
            margin:0;
            font-family: "Times New Roman", calibari;
            background-color:#FFFFFF;
        }

        nav{
            background-color:#090b2b;
            padding: 20px;
            display:flexbox
            font-size :18px;
        }

        nav a{
            color:blue;
            text-decoration:underline;
            margin-left:20px;
